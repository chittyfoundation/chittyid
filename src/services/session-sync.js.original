/**
 * ChittyOS Session Sync Service
 * Distributed session synchronization across all ChittyOS services
 * Maintains consistency between ChittyChat, ChittyID, and all ecosystem modules
 */

export class SessionSyncService {
  constructor(env) {
    this.env = env;

    // Session configuration
    this.config = {
      ttl: 3600, // 1 hour default
      maxSessions: 1000,
      syncInterval: 5000, // 5 seconds
      replicationFactor: 3,
      consistencyModel: 'eventual'
    };

    // Service registry - all ChittyOS services that need session sync
    this.services = {
      chittyid: { endpoint: 'id.chitty.cc', priority: 1 },
      chittychat: { endpoint: 'chat.chitty.cc', priority: 1 },
      chittyauth: { endpoint: 'auth.chitty.cc', priority: 0 },
      chittychain: { endpoint: 'chain.chitty.cc', priority: 2 },
      chittyforce: { endpoint: 'force.chitty.cc', priority: 2 },
      chittycore: { endpoint: 'core.chitty.cc', priority: 0 }
    };

    // Session state tracking
    this.sessionState = {
      local: new Map(),
      remote: new Map(),
      pending: new Map(),
      conflicts: new Map()
    };

    // Metrics
    this.metrics = {
      sessions_created: 0,
      sessions_synced: 0,
      conflicts_resolved: 0,
      sync_failures: 0,
      replication_lag_ms: 0
    };
  }

  /**
   * Initialize session for a user/project
   */
  async initializeSession(userId, projectId, metadata = {}) {
    const sessionId = this.generateSessionId(userId, projectId);

    const session = {
      id: sessionId,
      userId,
      projectId,
      metadata: {
        ...metadata,
        initiated: new Date().toISOString(),
        initiator: 'chittyid',
        version: 1
      },
      state: 'active',
      nodes: [this.getNodeId()],
      lastSync: new Date().toISOString(),
      checkpoints: []
    };

    // Store locally
    await this.storeLocal(session);

    // Initiate distributed sync
    await this.distributeSession(session);

    this.metrics.sessions_created++;

    return {
      success: true,
      sessionId,
      session,
      syncStatus: 'initiated'
    };
  }

  /**
   * Sync session state across services
   */
  async syncSession(sessionId, updates = {}) {
    const startTime = Date.now();

    try {
      // Get current session state
      const currentSession = await this.getSession(sessionId);

      if (!currentSession) {
        return {
          success: false,
          error: 'Session not found',
          sessionId
        };
      }

      // Apply updates with conflict resolution
      const updatedSession = await this.applyUpdates(currentSession, updates);

      // Create sync payload
      const syncPayload = {
        session: updatedSession,
        origin: this.getNodeId(),
        timestamp: new Date().toISOString(),
        vector: this.getVectorClock(sessionId),
        checksum: this.calculateChecksum(updatedSession)
      };

      // Distribute to all services
      const syncResults = await this.broadcastSync(syncPayload);

      // Handle sync responses
      const consensus = await this.achieveConsensus(syncResults);

      // Update metrics
      this.metrics.sessions_synced++;
      this.metrics.replication_lag_ms = Date.now() - startTime;

      return {
        success: true,
        sessionId,
        syncedNodes: consensus.nodes,
        conflicts: consensus.conflicts,
        latency: Date.now() - startTime
      };

    } catch (error) {
      this.metrics.sync_failures++;
      console.error(`Session sync failed for ${sessionId}:`, error);

      // Add to retry queue
      await this.queueForRetry(sessionId, updates);

      return {
        success: false,
        error: error.message,
        sessionId,
        queued: true
      };
    }
  }

  /**
   * Distribute session to all registered services
   */
  async distributeSession(session) {
    const promises = [];

    for (const [service, config] of Object.entries(this.services)) {
      promises.push(this.syncToService(service, config, session));
    }

    const results = await Promise.allSettled(promises);

    // Track successful replications
    const successful = results.filter(r => r.status === 'fulfilled').length;

    if (successful < this.config.replicationFactor) {
      console.warn(`Insufficient replication: ${successful}/${this.config.replicationFactor}`);
    }

    return {
      replicated: successful,
      total: results.length,
      results
    };
  }

  /**
   * Sync session to specific service
   */
  async syncToService(service, config, session) {
    const endpoint = `https://${config.endpoint}/api/session/sync`;

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-ChittyOS-Service': 'chittyid',
          'X-Session-ID': session.id,
          'X-Sync-Token': await this.generateSyncToken(session.id)
        },
        body: JSON.stringify({
          session,
          operation: 'upsert',
          priority: config.priority,
          timestamp: new Date().toISOString()
        })
      });

      if (!response.ok) {
        throw new Error(`Service ${service} sync failed: ${response.status}`);
      }

      const result = await response.json();

      // Update service health tracking
      await this.updateServiceHealth(service, true);

      return {
        service,
        success: true,
        version: result.version,
        checksum: result.checksum
      };

    } catch (error) {
      await this.updateServiceHealth(service, false);
      throw error;
    }
  }

  /**
   * Apply updates with conflict resolution
   */
  async applyUpdates(session, updates) {
    const conflicts = [];
    const merged = { ...session };

    for (const [key, value] of Object.entries(updates)) {
      if (session[key] !== undefined && session[key] !== value) {
        // Conflict detected
        const resolution = await this.resolveConflict(key, session[key], value);

        conflicts.push({
          field: key,
          current: session[key],
          proposed: value,
          resolved: resolution
        });

        merged[key] = resolution;
      } else {
        merged[key] = value;
      }
    }

    // Update version
    merged.version = (merged.version || 0) + 1;
    merged.lastModified = new Date().toISOString();

    // Store conflicts for audit
    if (conflicts.length > 0) {
      await this.storeConflicts(session.id, conflicts);
      this.metrics.conflicts_resolved += conflicts.length;
    }

    return merged;
  }

  /**
   * Resolve conflicts using Last-Write-Wins with vector clocks
   */
  async resolveConflict(field, currentValue, proposedValue) {
    // Check if we have timestamp metadata
    if (typeof currentValue === 'object' && currentValue._timestamp &&
        typeof proposedValue === 'object' && proposedValue._timestamp) {
      // Use timestamp for resolution
      return currentValue._timestamp > proposedValue._timestamp ? currentValue : proposedValue;
    }

    // Default to proposed value (Last-Write-Wins)
    return proposedValue;
  }

  /**
   * Achieve consensus across distributed nodes
   */
  async achieveConsensus(syncResults) {
    const votes = new Map();
    const conflicts = [];

    // Count votes for each version
    for (const result of syncResults) {
      if (result.success) {
        const key = `${result.version}:${result.checksum}`;
        votes.set(key, (votes.get(key) || 0) + 1);
      }
    }

    // Find majority version
    let maxVotes = 0;
    let consensusVersion = null;

    for (const [version, count] of votes.entries()) {
      if (count > maxVotes) {
        maxVotes = count;
        consensusVersion = version;
      }
    }

    // Check if we have quorum (>50% of nodes)
    const quorum = Math.floor(syncResults.length / 2) + 1;

    if (maxVotes < quorum) {
      conflicts.push({
        type: 'no_quorum',
        votes: Array.from(votes.entries()),
        required: quorum
      });
    }

    return {
      consensus: consensusVersion,
      votes: maxVotes,
      quorum: maxVotes >= quorum,
      nodes: syncResults.filter(r => r.success).map(r => r.service),
      conflicts
    };
  }

  /**
   * Broadcast sync to all nodes
   */
  async broadcastSync(payload) {
    const results = [];

    // Parallel sync to all services
    const promises = Object.entries(this.services).map(async ([service, config]) => {
      try {
        const result = await this.syncToService(service, config, payload.session);
        return { ...result, service };
      } catch (error) {
        return {
          service,
          success: false,
          error: error.message
        };
      }
    });

    return await Promise.allSettled(promises).then(results =>
      results.map(r => r.status === 'fulfilled' ? r.value : { success: false, error: r.reason })
    );
  }

  /**
   * Get session from local or distributed storage
   */
  async getSession(sessionId) {
    // Check local cache first
    if (this.sessionState.local.has(sessionId)) {
      return this.sessionState.local.get(sessionId);
    }

    // Check KV storage
    const stored = await this.env.SESSIONS?.get(`session:${sessionId}`);
    if (stored) {
      const session = JSON.parse(stored);
      this.sessionState.local.set(sessionId, session);
      return session;
    }

    // Query other nodes if not found locally
    const remoteSession = await this.queryRemoteNodes(sessionId);
    if (remoteSession) {
      await this.storeLocal(remoteSession);
      return remoteSession;
    }

    return null;
  }

  /**
   * Query remote nodes for session
   */
  async queryRemoteNodes(sessionId) {
    for (const [service, config] of Object.entries(this.services)) {
      try {
        const response = await fetch(`https://${config.endpoint}/api/session/${sessionId}`, {
          headers: {
            'X-ChittyOS-Service': 'chittyid',
            'X-Query-Token': await this.generateSyncToken(sessionId)
          }
        });

        if (response.ok) {
          return await response.json();
        }
      } catch (error) {
        console.error(`Failed to query ${service} for session ${sessionId}:`, error);
      }
    }

    return null;
  }

  /**
   * Store session locally
   */
  async storeLocal(session) {
    // Memory cache
    this.sessionState.local.set(session.id, session);

    // Persistent storage
    await this.env.SESSIONS?.put(`session:${session.id}`, JSON.stringify(session), {
      expirationTtl: this.config.ttl
    });

    // Update checkpoint
    await this.createCheckpoint(session.id, session);
  }

  /**
   * Create session checkpoint for recovery
   */
  async createCheckpoint(sessionId, session) {
    const checkpoint = {
      sessionId,
      timestamp: new Date().toISOString(),
      version: session.version,
      state: session.state,
      checksum: this.calculateChecksum(session)
    };

    await this.env.SESSIONS?.put(
      `checkpoint:${sessionId}:${Date.now()}`,
      JSON.stringify(checkpoint),
      { expirationTtl: 86400 } // 24 hours
    );
  }

  /**
   * Store conflict records
   */
  async storeConflicts(sessionId, conflicts) {
    await this.env.SESSIONS?.put(
      `conflicts:${sessionId}:${Date.now()}`,
      JSON.stringify({
        sessionId,
        conflicts,
        timestamp: new Date().toISOString(),
        resolver: this.getNodeId()
      }),
      { expirationTtl: 604800 } // 7 days
    );
  }

  /**
   * Queue session for retry
   */
  async queueForRetry(sessionId, updates) {
    const retryKey = `retry:${sessionId}`;
    const retryData = {
      sessionId,
      updates,
      attempts: 1,
      nextRetry: new Date(Date.now() + 30000).toISOString(), // 30 seconds
      created: new Date().toISOString()
    };

    // Check if already queued
    const existing = await this.env.SESSIONS?.get(retryKey);
    if (existing) {
      const data = JSON.parse(existing);
      retryData.attempts = data.attempts + 1;
      retryData.created = data.created;
      retryData.nextRetry = new Date(
        Date.now() + Math.min(30000 * Math.pow(2, retryData.attempts), 300000)
      ).toISOString();
    }

    await this.env.SESSIONS?.put(retryKey, JSON.stringify(retryData), {
      expirationTtl: 3600
    });
  }

  /**
   * Process retry queue
   */
  async processRetryQueue() {
    const retries = await this.env.SESSIONS?.list({ prefix: 'retry:' });

    if (!retries?.keys?.length) return;

    for (const key of retries.keys) {
      const data = JSON.parse(await this.env.SESSIONS.get(key.name));

      if (new Date(data.nextRetry) <= new Date()) {
        // Attempt retry
        const result = await this.syncSession(data.sessionId, data.updates);

        if (result.success || data.attempts >= 5) {
          // Success or max attempts reached
          await this.env.SESSIONS.delete(key.name);
        } else {
          // Update retry data
          await this.queueForRetry(data.sessionId, data.updates);
        }
      }
    }
  }

  /**
   * Update service health tracking
   */
  async updateServiceHealth(service, healthy) {
    const healthKey = `health:${service}`;
    const health = {
      service,
      healthy,
      lastCheck: new Date().toISOString(),
      consecutiveFailures: healthy ? 0 : 1
    };

    const existing = await this.env.SESSIONS?.get(healthKey);
    if (existing && !healthy) {
      const prev = JSON.parse(existing);
      health.consecutiveFailures = prev.consecutiveFailures + 1;
    }

    await this.env.SESSIONS?.put(healthKey, JSON.stringify(health), {
      expirationTtl: 3600
    });

    // Mark service as unhealthy if too many failures
    if (health.consecutiveFailures >= 3) {
      console.error(`Service ${service} marked unhealthy after ${health.consecutiveFailures} failures`);
    }
  }

  /**
   * Generate sync token for authentication
   */
  async generateSyncToken(sessionId) {
    const data = `${sessionId}:${this.getNodeId()}:${Date.now()}`;
    const encoder = new TextEncoder();
    const hash = await crypto.subtle.digest('SHA-256', encoder.encode(data));
    return btoa(String.fromCharCode(...new Uint8Array(hash)));
  }

  /**
   * Get vector clock for session
   */
  getVectorClock(sessionId) {
    // Simple vector clock implementation
    const clock = this.sessionState.local.get(`clock:${sessionId}`) || {};
    const nodeId = this.getNodeId();
    clock[nodeId] = (clock[nodeId] || 0) + 1;
    this.sessionState.local.set(`clock:${sessionId}`, clock);
    return clock;
  }

  /**
   * Calculate checksum for session data
   */
  calculateChecksum(session) {
    const data = JSON.stringify(session);
    let hash = 0;
    for (let i = 0; i < data.length; i++) {
      hash = ((hash << 5) - hash) + data.charCodeAt(i);
      hash = hash & hash; // Convert to 32bit integer
    }
    return Math.abs(hash).toString(16);
  }

  /**
   * Generate unique session ID
   */
  generateSessionId(userId, projectId) {
    const timestamp = Date.now().toString(36);
    const random = Math.random().toString(36).substr(2, 9);
    return `${userId}-${projectId}-${timestamp}-${random}`;
  }

  /**
   * Get current node identifier
   */
  getNodeId() {
    return this.env.NODE_ID || 'chittyid-primary';
  }

  /**
   * Get session sync status
   */
  async getSyncStatus(sessionId) {
    const session = await this.getSession(sessionId);
    if (!session) {
      return { exists: false };
    }

    // Check sync status across all nodes
    const nodeStatuses = await Promise.all(
      Object.entries(this.services).map(async ([service, config]) => {
        try {
          const response = await fetch(`https://${config.endpoint}/api/session/${sessionId}/status`, {
            headers: { 'X-ChittyOS-Service': 'chittyid' }
          });

          if (response.ok) {
            const status = await response.json();
            return { service, ...status };
          }
        } catch {
          return { service, available: false };
        }
      })
    );

    return {
      exists: true,
      sessionId,
      version: session.version,
      lastSync: session.lastSync,
      nodes: nodeStatuses,
      checkpoints: session.checkpoints?.length || 0
    };
  }

  /**
   * Clean up expired sessions
   */
  async cleanupSessions() {
    const now = Date.now();
    const expired = [];

    for (const [sessionId, session] of this.sessionState.local.entries()) {
      const age = now - new Date(session.initiated).getTime();
      if (age > this.config.ttl * 1000) {
        expired.push(sessionId);
      }
    }

    for (const sessionId of expired) {
      this.sessionState.local.delete(sessionId);
      await this.env.SESSIONS?.delete(`session:${sessionId}`);
    }

    return { cleaned: expired.length };
  }
}