{
  "version": "1.0.0",
  "session_sync": {
    "enabled": true,
    "auto_start": true,
    "sync_interval": 15000,
    "max_sessions": 50,
    "retention_days": 30
  },
  "chittyauth_integration": {
    "enabled": true,
    "validate_sessions": true,
    "cross_session_sync": true,
    "session_timeout": 86400000
  },
  "sync_data": {
    "mcp_projects": true,
    "tool_usage": true,
    "session_context": true,
    "chittyid_operations": true,
    "ai_conversations": false,
    "file_operations": true
  },
  "security": {
    "encrypt_sensitive": true,
    "hash_sessions": true,
    "audit_trail": true
  }
}